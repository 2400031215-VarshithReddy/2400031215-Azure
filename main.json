    "hostPoolType": {
      "type": "string",
      "defaultValue": "Pooled",
      "allowedValues": [
        "Pooled",
        "Personal"
      ],
      "metadata": {
        "description": "Host Pool Type"
      }
    },
    "loadBalancerType": {
      "type": "string",
      "defaultValue": "BreadthFirst",
      "allowedValues": [
        "BreadthFirst",
        "DepthFirst"
      ],
      "metadata": {
        "description": "Load balancing algorithm for pooled host pool"
      }
