          },
          "autoShutdownTime": {
            "value": "[parameters('autoShutdownTime')]"
          },
          "autoShutdownTimeZone": {
            "value": "[parameters('autoShutdownTimeZone')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
